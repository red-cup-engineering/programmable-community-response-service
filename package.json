{
  "name": "@red-cup-engineering/programmable-community-response-service",
  "version": "0.1.0",
  "type": "module",
  "description": "Transport-free declarative community command, tag, and trigger response planning.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/programmable-community-response-service.git"
  },
  "exports": {
    ".": {
      "import": "./src/index.mjs"
    }
  },
  "scripts": {
    "check": "node --check src/community-response.mjs && node --check src/index.mjs",
    "build": "npm run check",
    "test": "node --test test/*.test.mjs",
    "test:clean": "node scripts/clean-copy-check.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "sideEffects": false,
  "dependencies": {
    "@red-cup-engineering/computer-content-address-engineering-services-section": "0.2.0",
    "@red-cup-engineering/cryptographic-computer-data-engineering-services-section": "0.3.1"
  },
  "private": false,
  "files": [
    "package.json",
    "README*",
    "LICENSE*",
    "src",
    "scripts"
  ]
}
